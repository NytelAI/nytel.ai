<section class="nytel-cta">
  <h2>{{ call_to_action.heading }}</h2>
  <p>
    {{ call_to_action.audience }}.
  </p>
  <div class="nytel-cta-actions">
    <a href="mailto:{{ contact.email }}" class="nytel-btn nytel-btn-teal">{{ call_to_action.button }}</a>
    <a href="{{ call_to_action.secondary.url }}" class="nytel-btn nytel-btn-ghost">{{ call_to_action.secondary.label }}</a>
  </div>
</section>
<footer class="nytel-footer-bar">
  <div>{{ site.footer }}</div>
  <div class="nytel-footer-links">
    <a href="/">Home</a>
    <a href="mailto:{{ contact.general_email }}">{{ contact.general_email }}</a>
  </div>
</footer>
