{#- One-page home. Layout from /workspace/nytel-redesign/templates/index.html.j2 (approved, Rev. 6). Every string comes from _data/messaging.yaml. -#}
{%- macro mark(text, part, tag, cls='') -%}
{%- set bits = text.split(part) -%}
{{ bits[0] }}<{{ tag }}{% if cls %} class="{{ cls }}"{% endif %}>{{ part }}</{{ tag }}>{{ bits[1:]|join(part) }}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ subtitle.text }}">
  <meta property="og:title" content="{{ site.title }}">
  <meta property="og:description" content="{{ subtitle.text }}">
  <meta property="og:image" content="https://nytel.ai/og-image.png">
  <meta property="og:url" content="https://nytel.ai/">
  <meta property="og:type" content="website">
  <link rel="canonical" href="https://nytel.ai/">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ site.title }}">
  <meta name="twitter:description" content="{{ subtitle.text }}">
  <meta name="twitter:image" content="https://nytel.ai/og-image.png">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="chrome.css">
  <link rel="stylesheet" href="style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Nytel",
    "url": "https://nytel.ai",
    "logo": "https://nytel.ai/logo.svg",
    "image": "https://nytel.ai/og-image.png",
    "slogan": {{ tagline.text|tojson }},
    "description": {{ ("Nytel builds " ~ subtitle.text ~ " " ~ company.audience)|tojson }},
    "email": {{ contact.general_email|tojson }},
    "founder": [
{%- for p in team.people %}
      { "@type": "Person", "name": {{ p.name|tojson }}, "jobTitle": {{ ("Co-founder & " ~ p.title)|tojson }}, "description": {{ p.credential|tojson }} }{{ "," if not loop.last }}
{%- endfor %}
    ],
    "contactPoint": [
      { "@type": "ContactPoint", "contactType": "sales", "name": {{ contact.name|tojson }}, "email": {{ contact.email|tojson }}, "url": {{ call_to_action.secondary.url|tojson }}, "areaServed": "US", "availableLanguage": "English" },
      { "@type": "ContactPoint", "contactType": "general inquiries", "email": {{ contact.general_email|tojson }}, "areaServed": "US", "availableLanguage": "English" }
    ],
    "address": { "@type": "PostalAddress", "addressLocality": "Northern Virginia", "addressRegion": "VA", "addressCountry": "US" },
    "areaServed": "US",
    "knowsAbout": {{ company.specialties|tojson }},
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": {{ (capabilities.label ~ " (" ~ capabilities.status_label ~ ")")|tojson }},
      "itemListElement": [
{%- for c in built %}
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": {{ c.name|tojson }}{% if c.get("detail") %}, "description": {{ c.detail|tojson }}{% endif %} } }{{ "," if not loop.last }}
{%- endfor %}
      ]
    }
  }
  </script>
  <script type="application/ld+json">
  { "@context": "https://schema.org", "@type": "WebSite", "name": "Nytel", "url": "https://nytel.ai/", "description": {{ subtitle.text|tojson }}, "publisher": { "@type": "Organization", "name": "Nytel", "url": "https://nytel.ai" } }
  </script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><div class="wrap">
 <a class="logo" href="/"><img src="mark.svg" alt="" width="28" height="28">Nytel</a>
 <nav aria-label="Primary"><a href="#built">{{ site.nav.built }}</a><a href="{{ pages.whitepaper.url }}">{{ site.nav.whitepaper }}</a><a href="#contact">{{ site.nav.contact }}</a></nav>
</div></header>
<main id="main">
 <div class="hero"><div class="wrap">
  <h1>{{ mark(tagline.text, tagline.accent, 'span', 'accent') }}</h1>
  <p class="lead">{{ mark(subtitle.text, subtitle.emphasis, 'strong') }}</p>
  <a class="btn" href="mailto:{{ contact.email }}">{{ call_to_action.button }}</a>
 </div></div>
 <section id="built" aria-labelledby="built-h"><div class="wrap">
  <h2 id="built-h">{{ capabilities.label }} <span class="tag">{{ capabilities.status_label }}</span></h2>
  <ul class="list">{% for c in built %}
   <li>{{ c.name }}</li>{% endfor %}
  </ul>
  <p class="note">{{ capabilities.tested.text }}</p>
  <p class="note note-next">{{ capabilities.read_only_line }}</p>
  <p class="more"><a href="{{ pages.whitepaper.url }}">{{ pages.whitepaper.label }}</a></p>
 </div></section>
 <section id="how" aria-labelledby="how-h"><div class="wrap">
  <h2 id="how-h">{{ how_it_works.label.text }}</h2>
  <ul class="list">{% for pt in site_points %}
   <li>{{ pt }}</li>{% endfor %}
  </ul>
 </div></section>
 <section class="team" aria-labelledby="team-h"><div class="wrap">
  <h2 id="team-h">{{ team.label }}</h2>
  <div class="grid">{% for p in team.people %}
   <div class="item"><h3>{{ p.name }}</h3><p>{{ p.title }}</p><p class="cred">{{ p.credential }}</p></div>{% endfor %}
  </div>
 </div></section>
 {%- set link_partners = partners['items'] | selectattr('url', 'defined') | list | length == partners['items'] | length %}
 <section class="partners" aria-labelledby="partners-h"><div class="wrap">
  <h2 id="partners-h">{{ partners.label }}</h2>
  <div class="grid">{% for p in partners['items'] %}
   <div class="item"><h3>{% if link_partners %}<a href="{{ p.url }}">{{ p.short }}</a>{% else %}{{ p.short }}{% endif %}</h3><p>{{ p.long }}{% if p.get("place") %} · {{ p.place }}{% endif %}</p></div>{% endfor %}
  </div>
 </div></section>
 <section id="contact" class="close" aria-labelledby="cta-h"><div class="wrap">
  <h2 id="cta-h">{{ call_to_action.heading }}</h2>
  <p class="audience">{{ call_to_action.audience }}</p>
  <div class="actions"><a class="btn" href="mailto:{{ contact.email }}">{{ call_to_action.button }}</a>
  <a class="quiet" href="{{ call_to_action.secondary.url }}">{{ call_to_action.secondary.label }}</a></div>
 </div></section>
</main>
<footer><div class="wrap"><span>{{ site.footer }}</span><a href="{{ pages.whitepaper.url }}">{{ site.nav.whitepaper }}</a></div></footer>
</body>
</html>
